# WorkBuddy 硬件伴侣 · 主机配置示例
#
# 用法：复制本文件为 .env 再按需修改（.env 不进版本库，因为含本机端口等绑定值）。
#
#     cd host
#     copy .env.example .env      # Windows
#     cp .env.example .env        # macOS / Linux

# —— 串口 ——
# 留空 = 自动探测（按 VID:PID 303A:1001 找 ESP32-C3 的 USB-Serial/JTAG）。
# Windows 上一般是 COM4/COM5，也可以手填固定。
WB_PORT=

# —— 审批等待（秒）——
WB_ASK_TIMEOUT=90

# —— 语音识别 ——
# sense   : sherpa-onnx + SenseVoice（阿里 FunASR），带标点、数字归一化，
#           弱信号下比 paraformer-small 更连贯，5s 语音约 0.4s —— 默认
# sherpa  : sherpa-onnx + Paraformer-small，清晰音频逐字准确，无标点
# sapi    : Windows 自带中文听写引擎（备用；长句截断、空结果多）
# whisper : faster-whisper（需可用的 ctranslate2；部分机器 DLL 会崩，别默认用）
WB_ASR_BACKEND=sense
WB_WHISPER=small

# —— 麦克风 ——
# 输入增益(dB)。**这块板子必须给足**：实测 15dB 时 rms 只有 25（等于没录到），
# 识别返回空串；30dB 时 rms 278、peak 6161（离削顶还有 5 倍余量），逐字准确。
# 固件每次 open codec 会把 PGA 复位，所以固件自己也记住这个值并在 open 后重新施加。
WB_MIC_GAIN=30

# —— 注入 / 播报 ——
# 注入前把 WorkBuddy 切到前台（被遮挡时 Chromium 会销毁无障碍树，必须切回来）
WB_FOCUS=1

# 每轮结束时把结论念出来（设备扬声器）。1=开（默认）、0=关。
#
# 内容从哪来：Stop hook 的 payload 带 transcript_path（会话 jsonl），
# 服务侧从里面取最后一条 assistant 回复，清掉 markdown（表格/代码整段跳过），
# 截到合适长度再推流播报。整段约 7~25 秒，异步执行，不拖 hook。
#
# 想让播报更准，可以在回复里写一行（用 > 开头的引用）：
#     语音摘要：这句话会被念出来
# 有这行就只念它（上限 200 字）；没有才退回"清理后开头 120 字"。
WB_SPEAK_REPLY=1

# 播报音色关键字（留空＝自动挑第一个中文音色）
WB_SAPI_VOICE=

# —— 多会话 ——
# WorkBuddy 是单窗口多标签，所有会话共用同一个输入框，事件也挤到同一块屏。
# 有 2 个以上会话同时活跃时，服务会给每个会话分配 ①②③ 标签并标在消息前面，
# 标题栏显示 "WB① 2会话"。30 分钟没动静的会话释放标签。
# 查当前标签对应哪个会话：
#     python -m devlink.cli sessions
# 单会话时完全不加前缀，界面和以前一样。
